{
  "alias": "ice-hockey",
  "version": "1.0.0",
  "name": {
    "en": "Ice Hockey",
    "es": "Hockey sobre Hielo"
  },
  "description": {
    "en": "6-a-side ice rink discipline with 3 timed periods (20m), overtime, penalty shootouts, and goaltender role."
  },
  "images": [
    {
      "key": "modules/ice-hockey/1.0.0/ice-hockey-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 6,
    "maxPlayers": 6,
    "maxSubstitutes": 14
  },
  "rosterRoles": [
    {
      "code": "goaltender",
      "label": {
        "en": "Goaltender",
        "es": "Arquero"
      },
      "badge": "G"
    },
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "period",
      "label": {
        "en": "Period",
        "es": "Periodo"
      },
      "timed": true,
      "defaultDurationSeconds": 1200
    },
    {
      "name": "overtime",
      "label": {
        "en": "Overtime",
        "es": "Tiempo extra"
      },
      "timed": true,
      "defaultDurationSeconds": 300
    },
    {
      "name": "shootout",
      "label": {
        "en": "Shootout",
        "es": "Tanda de penales"
      },
      "timed": false
    }
  ],
  "eventDefinitions": [
    {
      "code": "goal",
      "label": {
        "en": "Goal",
        "es": "Gol"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "period",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "powerPlay": {
            "type": "boolean"
          },
          "emptyNet": {
            "type": "boolean"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "penalty-minor",
      "label": {
        "en": "Minor Penalty (2m)",
        "es": "Penalización menor (2m)"
      },
      "category": "negative",
      "permittedSegmentTypes": [
        "period",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "statistics": [
    {
      "code": "goals-for",
      "label": {
        "en": "Goals for",
        "es": "Goles a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "goals-against",
      "label": {
        "en": "Goals against",
        "es": "Goles en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins (Regulation)",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "overtime-losses",
      "label": {
        "en": "OT Losses",
        "es": "Derrotas en OT"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Standings",
        "es": "Posiciones"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "goal-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "GP",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "otl",
          "header": {
            "en": "OTL",
            "es": "POT"
          },
          "source": {
            "kind": "collector",
            "code": "overtime-losses"
          },
          "format": "number"
        },
        {
          "code": "gf",
          "header": {
            "en": "GF",
            "es": "GF"
          },
          "source": {
            "kind": "collector",
            "code": "goals-for"
          },
          "format": "number"
        },
        {
          "code": "ga",
          "header": {
            "en": "GA",
            "es": "GC"
          },
          "source": {
            "kind": "collector",
            "code": "goals-against"
          },
          "format": "number"
        },
        {
          "code": "goal-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "gf - ga"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "goals",
      "label": {
        "en": "Goals",
        "es": "Goles"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "ice-hockey-goals-win",
    "rules": [
      {
        "id": "most-goals-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "goals",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "single-elimination",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 3,
      "pointsPerDraw": 0,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "wins",
      "goals-for",
      "goals-against"
    ],
    "segments": {
      "regulationPeriods": 3
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
