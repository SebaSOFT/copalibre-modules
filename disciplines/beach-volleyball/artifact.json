{
  "alias": "beach-volleyball",
  "version": "1.0.0",
  "name": {
    "en": "Beach Volleyball",
    "es": "Vóley Playa"
  },
  "description": {
    "en": "2-a-side outdoor sand volleyball discipline with best-of-3 sets to 21/15 points and no substitutes."
  },
  "images": [
    {
      "key": "modules/beach-volleyball/1.0.0/beach-volleyball-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 2,
    "maxPlayers": 2
  },
  "rosterRoles": [
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "set",
      "label": {
        "en": "Set",
        "es": "Set"
      },
      "timed": false
    }
  ],
  "eventDefinitions": [
    {
      "code": "point",
      "label": {
        "en": "Point",
        "es": "Punto"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "set"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "ace": {
            "type": "boolean"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "sets-won",
      "label": {
        "en": "Sets won",
        "es": "Sets ganados"
      },
      "aggregation": "sum"
    },
    {
      "code": "sets-lost",
      "label": {
        "en": "Sets lost",
        "es": "Sets perdidos"
      },
      "aggregation": "sum"
    },
    {
      "code": "points-for",
      "label": {
        "en": "Points for",
        "es": "Puntos a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "points-against",
      "label": {
        "en": "Points against",
        "es": "Puntos en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "matches-won",
      "label": {
        "en": "Matches won",
        "es": "Partidos ganados"
      },
      "aggregation": "sum"
    },
    {
      "code": "matches-lost",
      "label": {
        "en": "Matches lost",
        "es": "Partidos perdidos"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Group Standings",
        "es": "Posiciones de Grupo"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "matches-won",
          "direction": "desc"
        },
        {
          "columnCode": "sets-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Pair",
            "es": "Pareja"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "P",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "matches-won",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "matches-won"
          },
          "format": "number"
        },
        {
          "code": "matches-lost",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "matches-lost"
          },
          "format": "number"
        },
        {
          "code": "sw",
          "header": {
            "en": "SW",
            "es": "SG"
          },
          "source": {
            "kind": "collector",
            "code": "sets-won"
          },
          "format": "number"
        },
        {
          "code": "sl",
          "header": {
            "en": "SL",
            "es": "SP"
          },
          "source": {
            "kind": "collector",
            "code": "sets-lost"
          },
          "format": "number"
        },
        {
          "code": "sets-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "sw - sl"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "points",
      "label": {
        "en": "Points",
        "es": "Puntos"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "beach-volleyball-best-of-three",
    "rules": [
      {
        "id": "close-match-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "close-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "set",
                "options": {}
              },
              {
                "id": "target",
                "name": "target",
                "type": "simple_number",
                "value": 2,
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "single-elimination",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 2,
      "pointsPerDraw": 0,
      "pointsPerLoss": 1
    },
    "tiebreakers": [
      "matches-won",
      "sets-won",
      "points-for"
    ],
    "segments": {
      "bestOf": 3
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
