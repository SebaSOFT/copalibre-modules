{
  "alias": "baseball",
  "version": "1.0.0",
  "name": {
    "en": "Baseball",
    "es": "Béisbol"
  },
  "description": {
    "en": "9-a-side bat-and-ball discipline with 9 innings, pitcher/catcher/DH roles, runs scoring, and extra innings."
  },
  "images": [
    {
      "key": "modules/baseball/1.0.0/baseball-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 9,
    "maxPlayers": 9,
    "maxSubstitutes": 16
  },
  "rosterRoles": [
    {
      "code": "pitcher",
      "label": {
        "en": "Pitcher",
        "es": "Lanzador"
      },
      "badge": "P"
    },
    {
      "code": "catcher",
      "label": {
        "en": "Catcher",
        "es": "Receptor"
      },
      "badge": "C"
    },
    {
      "code": "designated-hitter",
      "label": {
        "en": "Designated Hitter",
        "es": "Bateador designado"
      },
      "badge": "DH"
    },
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "CAP"
    }
  ],
  "segmentTypes": [
    {
      "name": "inning",
      "label": {
        "en": "Inning",
        "es": "Entrada"
      },
      "timed": false
    },
    {
      "name": "extra-inning",
      "label": {
        "en": "Extra inning",
        "es": "Entrada extra"
      },
      "timed": false
    }
  ],
  "eventDefinitions": [
    {
      "code": "run",
      "label": {
        "en": "Run",
        "es": "Carrera"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "inning",
        "extra-inning"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "rbi": {
            "type": "boolean"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "runs-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "runs-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "home-run",
      "label": {
        "en": "Home run",
        "es": "Cuadrangular (Home run)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "inning",
        "extra-inning"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "runsCount": {
            "type": "number"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "runs-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "home-runs",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "runs-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "runs-for",
      "label": {
        "en": "Runs for",
        "es": "Carreras a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "runs-against",
      "label": {
        "en": "Runs against",
        "es": "Carreras en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "home-runs",
      "label": {
        "en": "Home runs",
        "es": "Jonrones"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Standings",
        "es": "Posiciones"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "runs-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "G",
            "es": "JJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "JG"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "JP"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "rf",
          "header": {
            "en": "RS",
            "es": "CA"
          },
          "source": {
            "kind": "collector",
            "code": "runs-for"
          },
          "format": "number"
        },
        {
          "code": "ra",
          "header": {
            "en": "RA",
            "es": "CP"
          },
          "source": {
            "kind": "collector",
            "code": "runs-against"
          },
          "format": "number"
        },
        {
          "code": "runs-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "rf - ra"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "runs",
      "label": {
        "en": "Runs",
        "es": "Carreras"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "baseball-runs-win",
    "rules": [
      {
        "id": "most-runs-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "runs",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "single-elimination",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 1,
      "pointsPerDraw": 0,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "wins",
      "runs-for",
      "runs-against"
    ],
    "segments": {
      "regulationInnings": 9
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
