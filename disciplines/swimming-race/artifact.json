{
  "alias": "swimming-race",
  "version": "1.0.0",
  "name": {
    "en": "Swimming Race",
    "es": "Natación en Carreras"
  },
  "description": {
    "en": "Individual pool racing discipline across heats and finals where lowest elapsed time qualifies and wins."
  },
  "images": [
    {
      "key": "modules/swimming-race/1.0.0/swimming-race-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "individual"
  ],
  "rosterConstraints": {
    "minPlayers": 1,
    "maxPlayers": 1
  },
  "segmentTypes": [
    {
      "name": "heat",
      "label": {
        "en": "Heat",
        "es": "Serie"
      },
      "timed": true
    },
    {
      "name": "final",
      "label": {
        "en": "Final",
        "es": "Final"
      },
      "timed": true
    }
  ],
  "eventDefinitions": [
    {
      "code": "time-recorded",
      "label": {
        "en": "Time Recorded",
        "es": "Tiempo registrado"
      },
      "category": "neutral",
      "permittedSegmentTypes": [
        "heat",
        "final"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "elapsedMilliseconds": {
            "type": "number"
          }
        },
        "required": [
          "elapsedMilliseconds"
        ]
      },
      "effects": [
        {
          "kind": "statistic",
          "statisticCode": "best-time",
          "delta": 1
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "best-time",
      "label": {
        "en": "Best time",
        "es": "Mejor tiempo"
      },
      "aggregation": "min"
    }
  ],
  "tableLayouts": [
    {
      "code": "race-standings",
      "target": "group-phase",
      "label": {
        "en": "Times & Rankings",
        "es": "Tiempos y Posiciones"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "best-time",
          "direction": "asc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Swimmer",
            "es": "Nadador"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "best-time",
          "header": {
            "en": "Time",
            "es": "Tiempo"
          },
          "source": {
            "kind": "collector",
            "code": "best-time"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "time",
      "label": {
        "en": "Time",
        "es": "Tiempo"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "free-for-all",
    "heats"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "fastest-time-wins",
    "rules": [
      {
        "id": "min-time-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "best-time",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "heats",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 1,
      "pointsPerDraw": 0,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "best-time"
    ]
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
