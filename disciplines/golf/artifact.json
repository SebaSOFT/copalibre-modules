        "en": "Hole Score Recorded",
        "es": "Golpes en Hoyo"
      },
      "category": "neutral",
      "permittedSegmentTypes": [
        "round",
        "hole"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "strokes": {
            "type": "number"
          },
          "par": {
            "type": "number"
          }
        },
        "required": [
