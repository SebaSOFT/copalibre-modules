  "segmentTypes": [
    {
      "name": "round",
      "label": {
        "en": "Round",
        "es": "Ronda"
      },
      "timed": false
    },
    {
      "name": "hole",
      "label": {
        "en": "Hole",
        "es": "Hoyo"
      },
      "timed": false
    }
  ],
  "eventDefinitions": [
    {
      "code": "hole-score",
