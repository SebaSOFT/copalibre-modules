        {
          "code": "name",
          "header": {
            "en": "Player",
            "es": "Jugador"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "holes",
          "header": {
            "en": "Thru",
            "es": "Hoyos"
          },
          "source": {
            "kind": "collector",
            "code": "holes-played"
          },
          "format": "number"
        },
        {
          "code": "total-strokes",
          "header": {
            "en": "Total",
            "es": "Total"
          },
          "source": {
            "kind": "collector",
            "code": "total-strokes"
          },
          "format": "number"
        }
      ]
