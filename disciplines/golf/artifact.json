        ]
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "total-strokes",
          "delta": 1
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "total-strokes",
      "label": {
        "en": "Total strokes",
        "es": "Golpes totales"
      },
      "aggregation": "min"
    },
    {
      "code": "holes-played",
      "label": {
        "en": "Holes played",
        "es": "Hoyos jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "leaderboard-default",
      "target": "group-phase",
      "label": {
        "en": "Leaderboard",
        "es": "Clasificación"
      },
