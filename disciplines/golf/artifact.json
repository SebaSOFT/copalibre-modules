      {
        "id": "min-strokes-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
