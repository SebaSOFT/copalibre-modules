{
  "alias": "basketball",
  "version": "1.0.0",
  "name": {
    "en": "Basketball",
    "es": "Baloncesto"
  },
  "description": {
    "en": "Team invasion discipline with timed quarters, field goals (2pt/3pt), free throws, and player statistics."
  },
  "images": [
    {
      "key": "modules/basketball/1.0.0/basketball-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 5,
    "maxPlayers": 5,
    "maxSubstitutes": 7
  },
  "rosterRoles": [
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "quarter",
      "label": {
        "en": "Quarter",
        "es": "Cuarto"
      },
      "timed": true,
      "defaultDurationSeconds": 600
    },
    {
      "name": "overtime",
      "label": {
        "en": "Overtime",
        "es": "Tiempo extra"
      },
      "timed": true,
      "defaultDurationSeconds": 300
    }
  ],
  "eventDefinitions": [
    {
      "code": "field-goal-2pt",
      "label": {
        "en": "2-Point Field Goal",
        "es": "Doble (2 pts)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "assistedBy": {
            "type": "string"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "field-goals-2pt",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 2,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "field-goal-3pt",
      "label": {
        "en": "3-Point Field Goal",
        "es": "Triple (3 pts)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "assistedBy": {
            "type": "string"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "field-goals-3pt",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 3,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "free-throw",
      "label": {
        "en": "Free Throw",
        "es": "Tiro libre"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "free-throws",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "foul",
      "label": {
        "en": "Personal Foul",
        "es": "Falta personal"
      },
      "category": "negative",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "statistic",
          "statisticCode": "fouls",
          "delta": 1
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "points-for",
      "label": {
        "en": "Points for",
        "es": "Puntos a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "points-against",
      "label": {
        "en": "Points against",
        "es": "Puntos en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "field-goals-2pt",
      "label": {
        "en": "2-Pointers",
        "es": "Dobles"
      },
      "aggregation": "sum"
    },
    {
      "code": "field-goals-3pt",
      "label": {
        "en": "3-Pointers",
        "es": "Triples"
      },
      "aggregation": "sum"
    },
    {
      "code": "free-throws",
      "label": {
        "en": "Free throws",
        "es": "Tiros libres"
      },
      "aggregation": "sum"
    },
    {
      "code": "fouls",
      "label": {
        "en": "Fouls",
        "es": "Faltas"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Standings",
        "es": "Posiciones"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "points-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "GP",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "pf",
          "header": {
            "en": "PF",
            "es": "PF"
          },
          "source": {
            "kind": "collector",
            "code": "points-for"
          },
          "format": "number"
        },
        {
          "code": "pa",
          "header": {
            "en": "PA",
            "es": "PC"
          },
          "source": {
            "kind": "collector",
            "code": "points-against"
          },
          "format": "number"
        },
        {
          "code": "points-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "pf - pa"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "points",
      "label": {
        "en": "Points",
        "es": "Puntos"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "basketball-points-win",
    "rules": [
      {
        "id": "most-points-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "points",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "single-elimination",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 2,
      "pointsPerDraw": 0,
      "pointsPerLoss": 1
    },
    "tiebreakers": [
      "wins",
      "points-for",
      "points-against"
    ],
    "segments": {
      "regulationQuarters": 4
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
