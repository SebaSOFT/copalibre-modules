{
  "alias": "american-football",
  "version": "1.0.0",
  "name": {
    "en": "American Football",
    "es": "Fútbol Americano"
  },
  "description": {
    "en": "Team invasion discipline with timed quarters, touchdowns, field goals, conversions, and player statistics."
  },
  "images": [
    {
      "key": "modules/american-football/1.0.0/american-football-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 11,
    "maxPlayers": 11,
    "maxSubstitutes": 42
  },
  "rosterRoles": [
    {
      "code": "quarterback",
      "label": {
        "en": "Quarterback",
        "es": "Mariscal de campo"
      },
      "badge": "QB"
    },
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "quarter",
      "label": {
        "en": "Quarter",
        "es": "Cuarto"
      },
      "timed": true,
      "defaultDurationSeconds": 900
    },
    {
      "name": "overtime",
      "label": {
        "en": "Overtime",
        "es": "Tiempo extra"
      },
      "timed": true,
      "defaultDurationSeconds": 600
    }
  ],
  "eventDefinitions": [
    {
      "code": "touchdown",
      "label": {
        "en": "Touchdown",
        "es": "Touchdown"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "passerId": {
            "type": "string"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 6
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 6
        },
        {
          "kind": "statistic",
          "statisticCode": "touchdowns",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 6,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "field-goal",
      "label": {
        "en": "Field goal",
        "es": "Gol de campo"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "distanceYards": {
            "type": "number"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "field-goals",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 3,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "extra-point",
      "label": {
        "en": "Extra point (PAT)",
        "es": "Punto extra"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "two-point-conversion",
      "label": {
        "en": "2-point conversion",
        "es": "Conversión de 2 puntos"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 2,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "safety",
      "label": {
        "en": "Safety",
        "es": "Safety"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter",
        "overtime"
      ],
      "actorRequirement": "side",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 2,
          "awardTo": "every-other-side"
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "points-for",
      "label": {
        "en": "Points for",
        "es": "Puntos a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "points-against",
      "label": {
        "en": "Points against",
        "es": "Puntos en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "touchdowns",
      "label": {
        "en": "Touchdowns",
        "es": "Touchdowns"
      },
      "aggregation": "sum"
    },
    {
      "code": "field-goals",
      "label": {
        "en": "Field goals",
        "es": "Goles de campo"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "draws",
      "label": {
        "en": "Ties",
        "es": "Empates"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Division Standings",
        "es": "Tabla Divisional"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "points-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "GP",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "draws",
          "header": {
            "en": "T",
            "es": "E"
          },
          "source": {
            "kind": "collector",
            "code": "draws"
          },
          "format": "number"
        },
        {
          "code": "pf",
          "header": {
            "en": "PF",
            "es": "PF"
          },
          "source": {
            "kind": "collector",
            "code": "points-for"
          },
          "format": "number"
        },
        {
          "code": "pa",
          "header": {
            "en": "PA",
            "es": "PC"
          },
          "source": {
            "kind": "collector",
            "code": "points-against"
          },
          "format": "number"
        },
        {
          "code": "points-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "pf - pa"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "points",
      "label": {
        "en": "Points",
        "es": "Puntos"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "american-football-points-win",
    "rules": [
      {
        "id": "most-points-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "points",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "single-elimination",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 1,
      "pointsPerDraw": 0.5,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "wins",
      "points-for",
      "points-against"
    ],
    "segments": {
      "regulationQuarters": 4
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
