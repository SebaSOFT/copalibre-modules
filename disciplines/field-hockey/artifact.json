{
  "alias": "field-hockey",
  "version": "1.0.0",
  "name": {
    "en": "Field Hockey",
    "es": "Hockey sobre Césped"
  },
  "description": {
    "en": "11-a-side outdoor turf discipline with 4 timed quarters, penalty corners, and cards."
  },
  "images": [
    {
      "key": "modules/field-hockey/1.0.0/field-hockey-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 11,
    "maxPlayers": 11,
    "maxSubstitutes": 7
  },
  "rosterRoles": [
    {
      "code": "goalkeeper",
      "label": {
        "en": "Goalkeeper",
        "es": "Arquero"
      },
      "badge": "GK"
    },
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "quarter",
      "label": {
        "en": "Quarter",
        "es": "Cuarto"
      },
      "timed": true,
      "defaultDurationSeconds": 900
    },
    {
      "name": "shootout",
      "label": {
        "en": "Shootout",
        "es": "Penales australianos"
      },
      "timed": false
    }
  ],
  "eventDefinitions": [
    {
      "code": "goal",
      "label": {
        "en": "Goal",
        "es": "Gol"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "quarter"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "penaltyCorner": {
            "type": "boolean"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-against",
          "delta": 1,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "green-card",
      "label": {
        "en": "Green card (2m)",
        "es": "Tarjeta verde (2m)"
      },
      "category": "negative",
      "permittedSegmentTypes": [
        "quarter"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "statistics": [
    {
      "code": "goals-for",
      "label": {
        "en": "Goals for",
        "es": "Goles a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "goals-against",
      "label": {
        "en": "Goals against",
        "es": "Goles en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "draws",
      "label": {
        "en": "Draws",
        "es": "Empates"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Standings",
        "es": "Posiciones"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "goal-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "P",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "draws",
          "header": {
            "en": "D",
            "es": "E"
          },
          "source": {
            "kind": "collector",
            "code": "draws"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "gf",
          "header": {
            "en": "GF",
            "es": "GF"
          },
          "source": {
            "kind": "collector",
            "code": "goals-for"
          },
          "format": "number"
        },
        {
          "code": "ga",
          "header": {
            "en": "GA",
            "es": "GC"
          },
          "source": {
            "kind": "collector",
            "code": "goals-against"
          },
          "format": "number"
        },
        {
          "code": "goal-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "gf - ga"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "goals",
      "label": {
        "en": "Goals",
        "es": "Goles"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "field-hockey-goals-win",
    "rules": [
      {
        "id": "most-goals-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "goals",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "round-robin",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 3,
      "pointsPerDraw": 1,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "wins",
      "goals-for",
      "goals-against"
    ],
    "segments": {
      "regulationQuarters": 4
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
