{
  "alias": "rugby",
  "version": "1.0.0",
  "name": {
    "en": "Rugby Union",
    "es": "Rugby Union"
  },
  "description": {
    "en": "15-a-side team contact invasion sport with tries (5pts), conversions (2pts), penalty goals (3pts), and drop goals (3pts)."
  },
  "images": [
    {
      "key": "modules/rugby/1.0.0/rugby-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": [
    "team"
  ],
  "rosterConstraints": {
    "minPlayers": 15,
    "maxPlayers": 15,
    "maxSubstitutes": 8
  },
  "rosterRoles": [
    {
      "code": "captain",
      "label": {
        "en": "Captain",
        "es": "Capitán"
      },
      "badge": "C"
    }
  ],
  "segmentTypes": [
    {
      "name": "half",
      "label": {
        "en": "Half",
        "es": "Tiempo"
      },
      "timed": true,
      "defaultDurationSeconds": 2400
    },
    {
      "name": "extra-time",
      "label": {
        "en": "Extra time",
        "es": "Tiempo suplementario"
      },
      "timed": true,
      "defaultDurationSeconds": 600
    }
  ],
  "eventDefinitions": [
    {
      "code": "try",
      "label": {
        "en": "Try (5 pts)",
        "es": "Try (5 pts)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "half",
        "extra-time"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 5
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 5
        },
        {
          "kind": "statistic",
          "statisticCode": "tries",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 5,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "conversion",
      "label": {
        "en": "Conversion (2 pts)",
        "es": "Conversión (2 pts)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "half",
        "extra-time"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 2
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 2,
          "awardTo": "every-other-side"
        }
      ]
    },
    {
      "code": "penalty-goal",
      "label": {
        "en": "Penalty goal (3 pts)",
        "es": "Penal (3 pts)"
      },
      "category": "positive",
      "permittedSegmentTypes": [
        "half",
        "extra-time"
      ],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "points-for",
          "delta": 3
        },
        {
          "kind": "statistic",
          "statisticCode": "points-against",
          "delta": 3,
          "awardTo": "every-other-side"
        }
      ]
    }
  ],
  "statistics": [
    {
      "code": "points-for",
      "label": {
        "en": "Points for",
        "es": "Puntos a favor"
      },
      "aggregation": "sum"
    },
    {
      "code": "points-against",
      "label": {
        "en": "Points against",
        "es": "Puntos en contra"
      },
      "aggregation": "sum"
    },
    {
      "code": "tries",
      "label": {
        "en": "Tries",
        "es": "Tries"
      },
      "aggregation": "sum"
    },
    {
      "code": "wins",
      "label": {
        "en": "Wins",
        "es": "Victorias"
      },
      "aggregation": "sum"
    },
    {
      "code": "draws",
      "label": {
        "en": "Draws",
        "es": "Empates"
      },
      "aggregation": "sum"
    },
    {
      "code": "losses",
      "label": {
        "en": "Losses",
        "es": "Derrotas"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Tournament Standings",
        "es": "Tabla del Torneo"
      },
      "entityGranularity": "team",
      "defaultSort": [
        {
          "columnCode": "wins",
          "direction": "desc"
        },
        {
          "columnCode": "points-diff",
          "direction": "desc"
        }
      ],
      "columns": [
        {
          "code": "rank",
          "header": {
            "en": "Pos",
            "es": "#"
          },
          "source": {
            "kind": "rank"
          },
          "format": "number"
        },
        {
          "code": "name",
          "header": {
            "en": "Team",
            "es": "Equipo"
          },
          "source": {
            "kind": "entrant-name"
          },
          "format": "text"
        },
        {
          "code": "played",
          "header": {
            "en": "P",
            "es": "PJ"
          },
          "source": {
            "kind": "collector",
            "code": "played"
          },
          "format": "number"
        },
        {
          "code": "wins",
          "header": {
            "en": "W",
            "es": "G"
          },
          "source": {
            "kind": "collector",
            "code": "wins"
          },
          "format": "number"
        },
        {
          "code": "draws",
          "header": {
            "en": "D",
            "es": "E"
          },
          "source": {
            "kind": "collector",
            "code": "draws"
          },
          "format": "number"
        },
        {
          "code": "losses",
          "header": {
            "en": "L",
            "es": "P"
          },
          "source": {
            "kind": "collector",
            "code": "losses"
          },
          "format": "number"
        },
        {
          "code": "pf",
          "header": {
            "en": "PF",
            "es": "PF"
          },
          "source": {
            "kind": "collector",
            "code": "points-for"
          },
          "format": "number"
        },
        {
          "code": "pa",
          "header": {
            "en": "PA",
            "es": "PC"
          },
          "source": {
            "kind": "collector",
            "code": "points-against"
          },
          "format": "number"
        },
        {
          "code": "points-diff",
          "header": {
            "en": "Diff",
            "es": "Dif"
          },
          "source": {
            "kind": "computed",
            "expression": "pf - pa"
          },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    {
      "code": "points",
      "label": {
        "en": "Points",
        "es": "Puntos"
      },
      "source": "event-derived"
    }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "league",
    "round-robin-single-leg"
  ],
  "notificationRuleCapabilities": [],
  "winCondition": {
    "id": "rugby-points-win",
    "rules": [
      {
        "id": "most-points-wins",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "win-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "points",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "round-robin",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": {
      "pointsPerWin": 4,
      "pointsPerDraw": 2,
      "pointsPerLoss": 0
    },
    "tiebreakers": [
      "wins",
      "points-for",
      "points-against"
    ],
    "segments": {
      "regulationHalves": 2
    }
  },
  "fieldPolicies": {
    "tableLayouts": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "format": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "registration.publicOpen": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "safe"
    },
    "registration.requiresCheckIn": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": {
        "kind": "merged",
        "strategy": "union-list"
      },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": {
      "permission": {
        "kind": "replaced"
      },
      "mutationClass": "requires_rebuild"
    }
  }
}
