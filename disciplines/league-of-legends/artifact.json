{
  "alias": "league-of-legends",
  "version": "1.0.0",
  "name": {
    "en": "League of Legends",
    "es": "League of Legends"
  },
  "description": {
    "en": "5v5 MOBA discipline on Summoner's Rift with Blue and Red sides, positional roles (Top, JGL, Mid, Bot, Sup), and Nexus destruction victory."
  },
  "images": [
